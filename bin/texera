#!/usr/bin/env bash
# texera — Texera launcher. Composable targets; pins builds/runs to JDK 17.
#
# Targets (start one or more at once):
#   db        dev postgres (pgroonga) on :5432  — texera_db + texera_iceberg_catalog
#   infra     minio + lakefs (file-service compose)
#   obs       observability stack (VictoriaLogs/Metrics, Jaeger, Parca, OTel collector)
#   app       sbt-built backend services + frontend, in a tmux session (live logs)
#   app-be    backend services only (no frontend) — avoids the ng-serve file watcher
#   rust      (re)build the native Rust worker (amber/amber-rs); the engine spawns
#             it for any operator tagged rust:<op>. Built automatically on app start
#             if missing; run this after editing amber/amber-rs to force a rebuild.
#   dev       convenience = db + infra + app   (obs is separate, run `obs` on its own)
#   debug     full debug pipeline: db + infra + backends + the Amber engine under JDWP
#             on :5005, ready for :TexeraDebug in nvim (runs ./texera_debug)
#   docker    single-node, everything in containers (bin/single-node)
#   multi     this checkout as an isolated, proxied instance so several
#             checkouts run at once with no port juggling. Each is its own
#             compose project (named after the folder); a shared Traefik proxy
#             on :80 routes http://<folder>.localhost to its UI. Sub-modes:
#             'multi fresh' wipes this instance's volumes (DB re-inits from this
#             branch's sql/); 'multi down' stops it. See bin/texera-multi/.
#   box       docker-in-docker dev container per checkout. 'box up' builds/starts
#             '<folder>-dev' (full toolchain + its own inner dockerd) with the
#             source bind-mounted; afterwards every 'texera <target>' runs
#             INSIDE it against your real code (fresh/refresh/db/infra/obs/docker
#             all isolated per checkout). Proxy routes http://<folder>.localhost
#             to the box's ng-serve. box down|rm|shell|status|chown|build.
#   k8s       helm install into the current kube context (prod values)
#   fresh     full from-scratch install test: stop everything, wipe the dev DB
#             volume (re-inits from sql/), clean-rebuild the dist, then start dev
#   refresh   non-destructive: rebuild the backend and restart the app on the new
#             build, WITHOUT wiping any data (use after backend code changes)
#   prune     reclaim docker disk on the host AND inside every running box's inner
#             dockerd: dangling images, build cache, stopped containers. 'prune
#             all' also removes unused tagged images (re-pull/rebuild next start).
#             Volumes are NEVER touched, so DB/MinIO/lakeFS data is safe. Also
#             available as 'texera stop --prune' / '--prune-all'.
#
# Usage:
#   texera <target...>        start targets, e.g. `texera obs` or `texera db infra app`
#   texera stop [target...]   stop targets (no target = stop db+infra+obs+app)
#   texera rebuild [clean]    stop app, then clean sbt dist on JDK 17, unzip launchers (clean by default)
#   texera free-ports         kill whatever is holding the app/frontend ports
#   texera status             show what is up
#   texera attach             attach to the app tmux logs (Ctrl-b n/p switch, Ctrl-b d detach)
#   texera                    interactive: pick targets (space-separated)
#
# Auto-selects JDK 17 (TEXERA_JAVA_HOME or an sdkman 17*) for builds/launches; JDK
# 24+ breaks Hadoop/Iceberg (Subject.getSubject removed).

set -uo pipefail

c_grn=$'\033[32m'; c_red=$'\033[31m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_cyn=$'\033[36m'; c_off=$'\033[0m'
say()  { echo "${c_cyn}==>${c_off} $*"; }
ok()   { echo "  ${c_grn}✓${c_off} $*"; }
warn() { echo "  ${c_yel}!${c_off} $*"; }
die()  { echo "${c_red}error:${c_off} $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 is required but was not found on PATH"; }

# Find the Texera checkout: walk up from $PWD for a dir with build.sbt + amber/.
_find_root() {
  local d="$PWD"
  while [[ "$d" != / ]]; do
    [[ -f "$d/build.sbt" && -d "$d/amber" ]] && { printf '%s' "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
ROOT="$(_find_root)" || die "texera: not inside a Texera checkout (no build.sbt above $PWD). cd into texera / texera2 / texera3 first."

# This script's own dir, so `multi` can find bin/texera-multi/ (proxy + overlay)
# regardless of the caller's cwd. Resolve the symlink chain first: texera is on
# PATH as ~/.local/bin/texera -> ~/dotfiles/bin/texera, so an unresolved
# BASH_SOURCE would point SELF_DIR at ~/.local/bin and land the Traefik route
# files in a stray texera-multi/dynamic/ that nothing reads (new instances then
# 404 through the proxy while their box serves fine).
_self="${BASH_SOURCE[0]}"; _self="$(readlink -f "$_self" 2>/dev/null || echo "$_self")"
SELF_DIR="$(cd "$(dirname "$_self")" && pwd)"
MULTI_DIR="$SELF_DIR/texera-multi"

# ---- topology --------------------------------------------------------------
SESSION="texera-dev"
INFRA_COMPOSE="$ROOT/file-service/src/main/resources/docker-compose.yml"   # minio + lakefs
SINGLE_NODE="$ROOT/bin/single-node"                                        # full all-container deployment
OBS_COMPOSE="$ROOT/bin/observability/docker-compose.yml"                   # obs entry point (includes single-node)
PG_CONTAINER="texera-dev-postgres"
PG_IMAGE="docker.io/groonga/pgroonga:4.0.1-debian-15"                      # texera_ddl.sql needs pgroonga; FQ name for podman too
RUST_WORKER_DIR="$ROOT/amber/amber-rs"                                     # nested Rust workspace (data-plane engine)
RUST_WORKER_BIN="$RUST_WORKER_DIR/target/release/amber-worker"             # native worker the engine spawns for rust:<op> operators
OBS_SERVICES=(otel-collector victorialogs victoriametrics jaeger parca parca-agent)
OBS_PROFILES="observability-collector,observability-logs,observability-metrics,observability-traces,observability-profiles"
DEV_BACKENDS=(config-service access-control-service file-service
              workflow-compiling-service computing-unit-managing-service
              texera-web-application computing-unit-master)
# Host ports bound by the sbt-built services + frontend. Cleared by 'free-ports'
# and before 'app' starts so an orphaned JVM/ng-serve can't wedge the rebind.
# Infra/db/obs ports are not here (stopped via compose).
APP_PORTS=(8080 8081 8085 2552 8082 8888 9090 9091 9092 9094 9096 4200 1234 3000)
# Ports each service binds; FIRST is the health port. All are cleared on
# (re)launch. computing-unit-master also binds 2552 (pekko remoting seed).
declare -A SVC_PORTS=(
  [config-service]="9094" [access-control-service]="9096" [file-service]="9092"
  [workflow-compiling-service]="9090 9091" [computing-unit-managing-service]="8888 8082"
  [texera-web-application]="8080 8081" [computing-unit-master]="8085 2552" [frontend]="4200"
)

# ---- JDK 17 selection ------------------------------------------------------
JDK17=""
find_jdk17() {
  local c
  if [[ -n "${TEXERA_JAVA_HOME:-}" && -x "$TEXERA_JAVA_HOME/bin/java" ]]; then JDK17="$TEXERA_JAVA_HOME"; return; fi
  for c in "$HOME/.sdkman/candidates/java"/17*; do
    [[ -x "$c/bin/java" ]] && { JDK17="$c"; return; }
  done
  if command -v java >/dev/null && java -version 2>&1 | grep -q 'version "17\.'; then JDK17="${JAVA_HOME:-}"; fi
}
require_jdk17() {
  find_jdk17
  if [[ -z "$JDK17" ]]; then
    warn "no JDK 17 found (set TEXERA_JAVA_HOME or 'sdk install java 17...'). Texera will FAIL on JDK 24+"
    return 1
  fi
  ok "using JDK 17: $JDK17"
}
# run a command under JDK 17 (no-op env if JDK17 is empty)
with_jdk17() { if [[ -n "$JDK17" ]]; then JAVA_HOME="$JDK17" PATH="$JDK17/bin:$PATH" "$@"; else "$@"; fi; }

# ---- Node 24 selection -----------------------------------------------------
# The frontend needs Node >=24 (Angular 21). Picks one (TEXERA_NODE_HOME, an nvm
# v24.*, any nvm >=24, then the PATH node if it qualifies) without changing the shell.
NODE24_BIN=""
find_node24() {
  local d v
  if [[ -n "${TEXERA_NODE_HOME:-}" && -x "$TEXERA_NODE_HOME/bin/node" ]]; then NODE24_BIN="$TEXERA_NODE_HOME/bin"; return; fi
  # prefer the highest v24.* from nvm (the LTS line the project targets)
  for d in $(ls -d "$HOME/.nvm/versions/node"/v24.* 2>/dev/null | sort -V -r); do
    [[ -x "$d/bin/node" ]] && { NODE24_BIN="$d/bin"; return; }
  done
  # the PATH node, if it's already >=24
  if command -v node >/dev/null; then
    v="$(node -v 2>/dev/null)"; v="${v#v}"; v="${v%%.*}"
    if [[ "$v" =~ ^[0-9]+$ && "$v" -ge 24 ]]; then NODE24_BIN="$(dirname "$(command -v node)")"; return; fi
  fi
  # any other nvm node >=24 (e.g. v25)
  for d in $(ls -d "$HOME/.nvm/versions/node"/v* 2>/dev/null | sort -V -r); do
    v="$(basename "$d")"; v="${v#v}"; v="${v%%.*}"
    [[ -x "$d/bin/node" && "$v" =~ ^[0-9]+$ && "$v" -ge 24 ]] && { NODE24_BIN="$d/bin"; return; }
  done
}
require_node24() {
  find_node24
  if [[ -z "$NODE24_BIN" ]]; then
    warn "no Node >=24 found (set TEXERA_NODE_HOME or 'nvm install 24'). The frontend (Angular 21) needs it; ng serve may hang or fail to bind :4200 on older Node."
    return 1
  fi
  ok "using Node: $("$NODE24_BIN/node" -v) ($NODE24_BIN)"
}

# ---- container engine (docker if its daemon is up, else rootless podman) ----
# Prefer a reachable docker daemon (existing volumes/containers live there), else
# fall back to rootless podman (runs the same images, no daemon/sudo needed).
# Cached in $CE after the first probe.
CE=""
detect_ce() {
  [[ -n "$CE" ]] && return 0
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    CE=docker
  elif command -v podman >/dev/null 2>&1; then
    CE=podman
    [[ -n "${_ce_warned:-}" ]] || { warn "docker daemon unreachable, using rootless podman (no sudo/firewalld needed)"; _ce_warned=1; }
  elif command -v docker >/dev/null 2>&1; then
    CE=docker   # daemon down and no podman: let it fail loudly
  else
    return 1
  fi
  return 0
}
need_ce() { detect_ce || die "no container engine: start the docker daemon or install podman"; }
ce()      { need_ce; "$CE" "$@"; }

# `podman compose` needs the rootless podman API socket, which isn't auto-started
# (unlike `podman run`). Start the per-user podman.socket (or a transient `podman
# system service`), wait for it, and export DOCKER_HOST. No-op on docker.
PODMAN_SOCK=""
# True only if something actually answers (a stale socket file can linger).
podman_sock_live() { podman --remote --url "unix://$1" version >/dev/null 2>&1; }
ensure_podman_socket() {
  [[ "$CE" == podman ]] || return 0
  local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
  if ! podman_sock_live "$sock"; then
    # idempotent: re-binds even with a stale socket file present
    systemctl --user start podman.socket >/dev/null 2>&1 \
      || { podman system service --time=0 "unix://$sock" >/dev/null 2>&1 & }
    local i; for i in $(seq 1 25); do podman_sock_live "$sock" && break; sleep 0.2; done
  fi
  podman_sock_live "$sock" || { warn "podman API socket not responding at $sock; compose may fail"; return 1; }
  export DOCKER_HOST="unix://$sock"
  [[ -n "$PODMAN_SOCK" ]] || { ok "podman API socket ready ($DOCKER_HOST)"; PODMAN_SOCK="$sock"; }
}

# ---- helpers ---------------------------------------------------------------
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && return 0 || return 1; }
dc() { need_ce; ensure_podman_socket; "$CE" compose -f "$1" "${@:2}"; }
launcher() { find "$ROOT" -maxdepth 5 -type f -path "*/target/*/bin/$1" ! -path '*/universal/*' -perm -u+x 2>/dev/null | sort | head -1; }
have_container() { detect_ce >/dev/null 2>&1 || return 1; "$CE" ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$1"; }
running_container() { detect_ce >/dev/null 2>&1 || return 1; "$CE" ps --format '{{.Names}}' 2>/dev/null | grep -qx "$1"; }

# Wait for lakeFS to serve before launching backends: file-service health-checks
# it at boot and exit(1)s if unreachable, and `compose up -d` returns before
# lakeFS is ready, so a back-to-back app start races it.
# Poll :8000/_health up to $1 seconds (default 60); 0 if healthy, 1 on timeout.
_lakefs_health_wait() {
  command -v curl >/dev/null 2>&1 || { port_open 8000 && return 0 || return 1; }
  local i; for i in $(seq 1 "${1:-60}"); do
    [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:8000/_health 2>/dev/null)" == 200 ]] && return 0
    printf '.'; sleep 1
  done
  return 1
}
wait_for_lakefs() {
  printf "  waiting for lakeFS health (:8000)"
  _lakefs_health_wait 30 && { echo; ok "lakeFS healthy (:8000)"; return 0; }
  # A wedged lakeFS never self-recovers (crash loop, or detached from its network
  # after a docker<->podman swap). Recreate infra once and re-poll; keeps volumes.
  echo; warn "lakeFS not healthy after 30s, recreating infra (likely a wedged container)"
  dc "$INFRA_COMPOSE" up -d --force-recreate >/dev/null 2>&1
  printf "  re-waiting for lakeFS health (:8000)"
  _lakefs_health_wait 60 && { echo; ok "lakeFS healthy (:8000)"; return 0; }
  echo; warn "lakeFS still not healthy on :8000, file-service may crash on startup"
  return 1
}

# ---- port clearing ---------------------------------------------------------
# PIDs listening on a TCP port; prefer lsof, fall back to ss.
pids_on_port() {
  local p="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -t -iTCP:"$p" -sTCP:LISTEN 2>/dev/null
  elif command -v ss >/dev/null 2>&1; then
    ss -ltnpH 2>/dev/null | grep -oE "[:*]$p [^,]*pid=[0-9]+" | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u
  fi
}
# SIGTERM the listener(s) on $1, escalate to SIGKILL if it doesn't release.
free_port() {
  local p="$1" pid procs="" found=0
  for pid in $(pids_on_port "$p"); do
    found=1; procs+="$pid($(ps -p "$pid" -o comm= 2>/dev/null)) "
    kill "$pid" 2>/dev/null
  done
  [[ $found -eq 0 ]] && return 1
  local i
  for i in $(seq 1 10); do port_open "$p" || { ok "freed :$p — was $procs"; return 0; }; sleep 0.3; done
  for pid in $(pids_on_port "$p"); do kill -9 "$pid" 2>/dev/null; done
  sleep 0.3
  port_open "$p" && { warn ":$p still in use after SIGKILL — was $procs"; return 0; } || ok "force-freed :$p — was $procs"
}
free_ports() {
  command -v lsof >/dev/null 2>&1 || command -v ss >/dev/null 2>&1 || { warn "neither lsof nor ss found — cannot free ports"; return; }
  say "clearing app ports"
  local p any=0
  for p in "${APP_PORTS[@]}"; do port_open "$p" && { free_port "$p"; any=1; }; done
  [[ $any -eq 0 ]] && ok "all app ports already free (${APP_PORTS[*]})"
}

# ---- protoc (python betterproto codegen) -----------------------------------
# The sbt build's genPythonProto step runs bin/python-proto-gen.sh, which needs
# protoc AND the well-known types (google/protobuf/*.proto) on protoc's include
# path (it derives that path as <dir-of-protoc>/../include). The official protoc
# release bundles them; a distro protoc (e.g. Ubuntu protobuf-compiler without
# libprotobuf-dev, as in the dev box) ships only the binary, so the build dies
# "google/protobuf/descriptor.proto: File not found". If the types aren't
# resolvable, install the pinned official release into /usr/local so its
# /usr/local/bin/protoc wins on PATH and its /usr/local/include has the types.
protoc_wkt_ok() {
  local d
  for d in "$(dirname "$(dirname "$(command -v protoc 2>/dev/null)")")/include" \
           /usr/local/include /usr/include; do
    [[ -f "$d/google/protobuf/descriptor.proto" ]] && return 0
  done
  return 1
}
ensure_protoc() {
  command -v protoc >/dev/null 2>&1 || return 0   # no protoc: the build skips python proto-gen, nothing to fix
  protoc_wkt_ok && return 0
  command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1 \
    || { warn "protoc lacks the well-known types and curl/unzip are unavailable; python proto-gen will fail. Install libprotobuf-dev or the official protoc."; return 1; }
  local ver=""; [[ -f "$ROOT/bin/protoc-version.txt" ]] && ver="$(tr -d '[:space:]' < "$ROOT/bin/protoc-version.txt")"
  [[ -n "$ver" ]] || { warn "no bin/protoc-version.txt; cannot auto-install protoc"; return 1; }
  local arch; case "$(uname -m)" in
    x86_64|amd64)   arch=x86_64 ;;
    aarch64|arm64)  arch=aarch_64 ;;
    *) warn "unknown arch $(uname -m); install the official protoc $ver by hand"; return 1 ;;
  esac
  if [[ ! -w /usr/local/bin && "$(id -u)" != 0 ]]; then
    warn "protoc lacks the well-known types; install the official protoc $ver into /usr/local (needs root) or 'apt install libprotobuf-dev'"
    return 1
  fi
  say "installing official protoc $ver into /usr/local (bundles google/protobuf/*.proto)"
  local url="https://github.com/protocolbuffers/protobuf/releases/download/v${ver}/protoc-${ver}-linux-${arch}.zip"
  local zip="/tmp/texera-protoc-$$.zip"
  if curl -fsSL -o "$zip" "$url" && unzip -oq "$zip" -d /usr/local; then
    chmod +x /usr/local/bin/protoc 2>/dev/null; rm -f "$zip"; hash -r 2>/dev/null || true
    protoc_wkt_ok && ok "protoc $ver installed (/usr/local)" || { warn "protoc install did not supply the well-known types"; return 1; }
  else
    rm -f "$zip"; warn "could not download/install protoc $ver from $url"; return 1
  fi
}

# ---- rebuild ---------------------------------------------------------------
rebuild() {
  need sbt; need unzip; require_jdk17 || die "rebuild needs JDK 17"
  ensure_protoc || true   # make the well-known protos resolvable, else python proto-gen fails the build
  local mode="${1:-}"
  local -a cmds=(); [[ -n "$mode" ]] && cmds+=("$mode"); cmds+=(dist)
  say "sbt ${cmds[*]} (JDK 17) — this takes a few minutes…"
  # betterproto writes progress to stderr, which sbt tags [error] on a clean run.
  # Relabel those to [info]; pipefail preserves sbt's real exit status.
  with_jdk17 sbt "${cmds[@]}" 2>&1 \
    | sed -uE 's/^\[error\] (Writing )/[info] \1/' \
    || die "sbt dist failed"
  say "unzipping dist launchers"
  local z
  while IFS= read -r z; do unzip -oq "$z" -d "$(dirname "$z")/.."; ok "$(basename "$z")"; done \
    < <(find "$ROOT" -maxdepth 6 -path '*/target/universal/*.zip' ! -path '*/common/*' ! -path '*/node_modules/*' 2>/dev/null | sort)
  ok "rebuild complete"
}
# ---- python UDF venv (in-box only) -----------------------------------------
# The dev box has no Python UDF runtime (the host venv isn't mounted), so Python
# UDF operators die with ModuleNotFoundError (pyarrow/betterproto/...). Build a
# venv from THIS checkout's amber/requirements.txt (cached in a box volume) and
# point UDF_PYTHON_PATH at it. Re-installs only when requirements.txt changes.
TEXERA_VENV="${TEXERA_VENV:-/opt/texera-venv}"
ensure_py_venv() {
  [[ -n "${TEXERA_DEV_CONTAINER:-}" ]] || return 0   # only meaningful inside a box
  local req="$ROOT/amber/requirements.txt"
  [[ -f "$req" ]] || { warn "no amber/requirements.txt; skipping Python UDF venv"; return 0; }
  local sum; sum="$(md5sum "$req" 2>/dev/null | cut -d' ' -f1)"
  if [[ -x "$TEXERA_VENV/bin/python" && "$(cat "$TEXERA_VENV/.reqsum" 2>/dev/null)" == "$sum" ]]; then
    ok "Python UDF venv ready ($TEXERA_VENV)"; return 0
  fi
  say "setting up Python UDF venv from amber/requirements.txt (first time is slow)"
  [[ -x "$TEXERA_VENV/bin/python" ]] || python3 -m venv "$TEXERA_VENV" || { warn "venv create failed"; return 1; }
  "$TEXERA_VENV/bin/pip" install -q --upgrade pip >/dev/null 2>&1
  if "$TEXERA_VENV/bin/pip" install -q -r "$req"; then
    echo "$sum" > "$TEXERA_VENV/.reqsum"; ok "Python UDF venv ready ($TEXERA_VENV)"
  else
    warn "Python UDF venv install failed; Python UDFs will not run"; return 1
  fi
}
ensure_built() {
  local missing=() n
  for n in "${DEV_BACKENDS[@]}"; do [[ -n "$(launcher "$n")" ]] || missing+=("$n"); done
  [[ ${#missing[@]} -eq 0 ]] && return 0
  warn "missing launchers: ${missing[*]} — building"
  rebuild
}

# ---- rust worker (native data-plane engine) --------------------------------
# Build the amber-worker binary the JVM engine spawns for any operator tagged
# rust:<op>. Skipped (with a warning, not a hard fail) if cargo is missing so the
# rest of the stack still comes up. Pass 'force' to rebuild even if present
# (after editing amber/amber-rs). The engine finds it via AMBER_RUST_WORKER_BIN,
# exported into the backend launch env by up_app/run_debug.
ensure_rust_worker() {
  local force="${1:-}"
  if [[ "$force" != force && -x "$RUST_WORKER_BIN" ]]; then
    ok "rust worker present ($RUST_WORKER_BIN)"; return 0
  fi
  if ! command -v cargo >/dev/null 2>&1; then
    warn "cargo not found; skipping Rust worker build (rust:<op> operators will fail to start)"; return 1
  fi
  [[ -d "$RUST_WORKER_DIR" ]] || { warn "no Rust workspace at $RUST_WORKER_DIR; skipping"; return 1; }
  # prost/tonic build scripts need protoc; prefer an explicit PROTOC, else the one on PATH.
  local protoc="${PROTOC:-}"; [[ -z "$protoc" && -x /usr/bin/protoc ]] && protoc=/usr/bin/protoc
  say "building Rust amber-worker (release)${force:+ [force]}..."
  ( cd "$RUST_WORKER_DIR" && ${protoc:+env PROTOC="$protoc"} cargo build --release -p amber-net --bin amber-worker ) \
    && ok "built $RUST_WORKER_BIN" \
    || { warn "Rust worker build failed; rust:<op> operators will fail to start"; return 1; }
}

# ---- fresh (from-scratch install test) -------------------------------------
# Simulates a clean machine: tear down the dev stack, drop the Postgres volume so
# it re-inits from sql/, clean-rebuild the dist, then bring infra+app up.
# WARNING: WIPES the dev database. Use 'refresh' for everyday code changes.
#
# DB-before-build: JOOQ codegen introspects the live :5432 schema during the sbt
# build, so the wiped DB must be re-initialized from sql/ BEFORE 'rebuild clean'
# (else codegen falls back to stale classes and the clean compile dies).
run_fresh() {
  need_ce
  say "fresh: tearing down the dev stack"
  down_app; down_obs
  # Wipe infra volumes too: keeping lakeFS/MinIO data while the DB resets dataset
  # IDs to 1 makes new datasets collide (lakeFS 409 "not unique"). 'down -v'
  # resets the DB and object store together.
  say "fresh: tearing down infra + wiping lakeFS/MinIO volumes"
  dc "$INFRA_COMPOSE" down -v >/dev/null 2>&1 && ok "minio/lakefs down (volumes wiped)" || ok "infra already down"
  # Remove the container + volume so the next up_db re-inits from sql/.
  have_container "$PG_CONTAINER" && { "$CE" rm -f "$PG_CONTAINER" >/dev/null 2>&1 && ok "removed $PG_CONTAINER"; }
  # Fail loudly if the volume can't be removed (another container references it):
  # a surviving stale schema would poison JOOQ codegen and break the clean build.
  if "$CE" volume inspect texera-dev-pgdata >/dev/null 2>&1; then
    "$CE" volume rm texera-dev-pgdata >/dev/null 2>&1 \
      && ok "wiped DB volume texera-dev-pgdata (will re-init from sql/)" \
      || die "could not remove volume texera-dev-pgdata: another container still references it, so the old schema would survive. Find + remove it: $CE ps -a --filter volume=texera-dev-pgdata"
  else
    ok "DB volume already absent (will re-init from sql/)"
  fi
  # Guard: up_db reuses whatever is on :5432. Having removed our own container,
  # anything still on :5432 is a foreign DB whose schema would poison codegen.
  if port_open 5432; then
    die "fresh: something other than $PG_CONTAINER is already serving :5432 (we just removed ours). The build would generate JOOQ classes from that DB's schema, not this branch's sql/. Stop it first ($CE ps --filter publish=5432), then re-run 'texera fresh'."
  fi
  # Bring the wiped DB up first so codegen sees the fresh schema (postgres opens
  # :5432 only after sql/ init finishes, so up_db's wait guarantees it's loaded).
  say "fresh: starting db (re-inits from sql/), needed for JOOQ codegen before the build"
  up_db
  port_open 5432 || die "fresh: postgres never opened :5432, so JOOQ codegen cannot run. Check: $CE logs $PG_CONTAINER"
  # Wipe the gitignored jOOQ-generated sources so the rebuild regenerates them for
  # this schema. 'sbt clean' doesn't touch them (under src/), and a stale table
  # file would reference keys jOOQ no longer emits, breaking javac.
  local jooq_gen="$ROOT/common/dao/src/main/scala/org/apache/texera/dao/jooq/generated"
  [[ -d "$jooq_gen" ]] && { rm -rf "$jooq_gen" && ok "cleared stale jOOQ generated sources (regenerate from fresh schema)"; }
  rebuild clean
  say "fresh: starting dev (infra + app)"
  local t
  for t in infra app; do start_target "$t"; done
}

# ---- dev DB schema sync (non-destructive) ----------------------------------
# Run psql against the dev DB: exec inside our postgres container if it serves
# :5432, else a host psql client. Returns 127 if neither exists. Forwards stdin.
_psql() {
  if running_container "$PG_CONTAINER"; then
    "$CE" exec -i "$PG_CONTAINER" psql "$@"
  elif command -v psql >/dev/null 2>&1; then
    PGPASSWORD=postgres psql -h 127.0.0.1 -p 5432 "$@"
  else
    return 127
  fi
}
# sorted list of tables in the texera_db schema (one per line)
_db_tables() { _psql -U postgres -d texera_db -tAqc \
  "SELECT tablename FROM pg_tables WHERE schemaname='texera_db' ORDER BY 1;" 2>/dev/null; }

# Bring the live :5432 schema up to date with sql/texera_ddl.sql WITHOUT wiping
# data, so JOOQ codegen sees tables added to the DDL since this DB was first
# initialized (a non-empty volume doesn't re-run sql/ init). Strips DROP and
# CREATE DATABASE lines, leaving idempotent CREATE TABLE IF NOT EXISTS, so only
# missing tables are added. Column changes aren't covered; those need 'fresh'.
sync_dev_schema() {
  port_open 5432 || { warn "postgres not on :5432, cannot sync schema; JOOQ codegen may miss new tables"; return 0; }
  local ddl="$ROOT/sql/texera_ddl.sql"
  [[ -f "$ddl" ]] || { warn "sql/texera_ddl.sql not found, skipping schema sync"; return 0; }
  detect_ce >/dev/null 2>&1
  if ! running_container "$PG_CONTAINER" && ! command -v psql >/dev/null 2>&1; then
    warn "cannot reach postgres ($PG_CONTAINER not running and no host psql), skipping schema sync; codegen may miss new tables"
    return 0
  fi
  say "syncing dev DB schema from sql/texera_ddl.sql (adds missing tables; data preserved)"
  local before after added
  before="$(_db_tables)"
  # ON_ERROR_STOP=0: pre-existing CREATE TYPE/INDEX lines error harmlessly. The
  # file's own \c switches into texera_db, so connect to the postgres maint DB.
  grep -viE '^[[:space:]]*(DROP[[:space:]]+(DATABASE|TABLE|TYPE)|CREATE[[:space:]]+DATABASE)' "$ddl" \
    | _psql -v ON_ERROR_STOP=0 -U postgres -d postgres -q >/dev/null 2>&1
  after="$(_db_tables)"
  added="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | grep -v '^$' | paste -sd' ' -)"
  if [[ -n "$added" ]]; then ok "schema synced, added: $added"; else ok "schema already up to date"; fi
}

# ---- refresh (non-destructive rebuild + restart) ---------------------------
# Everyday "I changed backend code" command: recompile and relaunch the app on
# the new build without touching data. Mainly for backend edits (ng serve already
# hot-reloads). Incremental by default; pass 'clean' for a full rebuild. Brings
# db+infra up if down (idempotent).
run_refresh() {
  local mode="${1:-}"
  say "refresh: rebuild + restart (data preserved, no wipe)"
  down_app                 # stop services so they relaunch on the new build
  up_db                    # DB up before build: codegen introspects the live :5432 schema
  sync_dev_schema          # add tables new in sql/ so codegen sees them (non-destructive)
  # Translate a codegen "table not found" failure into a 'fresh' hint rather than
  # a raw Scala compile error (the additive sync can't fix column changes).
  local log="${TMPDIR:-/tmp}/texera-refresh-build.log"
  if ! ( rebuild "$mode" ) 2>&1 | tee "$log"; then
    echo
    if grep -q "not found: value [A-Z]" "$log"; then
      local missing
      missing="$(grep -oE "not found: value [A-Z_]+" "$log" | sed 's/not found: value //' | sort -u | paste -sd', ' -)"
      die "refresh build failed: JOOQ codegen is missing table(s) [$missing] from the dev DB.
  The auto schema-sync only ADDS new tables; a column change or rename to an
  existing table needs a full reset. Fix with 'texera fresh' (WARNING:
  this WIPES the dev DB), or apply the matching sql/updates/*.sql to the running
  postgres by hand, then re-run 'texera refresh'."
    fi
    die "refresh build failed, see the build output above (full log: $log)."
  fi
  up_infra                 # ensure runtime deps are up (idempotent; never wipes a volume)
  up_app yes
}

# ---- db --------------------------------------------------------------------
up_db() {
  if port_open 5432; then ok "postgres already on :5432, using it"; return; fi
  need_ce
  if have_container "$PG_CONTAINER"; then "$CE" start "$PG_CONTAINER" >/dev/null
  else
    say "starting dev postgres ($PG_IMAGE) on :5432 via $CE, init from sql/"
    # ':ro,z' relabels the bind-mounted sql/ for SELinux so podman can read it.
    "$CE" run -d --name "$PG_CONTAINER" \
      -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=postgres \
      -p 5432:5432 -v "$ROOT/sql:/docker-entrypoint-initdb.d:ro,z" \
      -v texera-dev-pgdata:/var/lib/postgresql/data "$PG_IMAGE" >/dev/null
  fi
  printf "  waiting for postgres"; local i
  for i in $(seq 1 30); do port_open 5432 && break; printf '.'; sleep 1; done; echo
  port_open 5432 && ok "postgres up (:5432)" || warn "postgres did not open :5432, check: $CE logs $PG_CONTAINER"
}
down_db() {
  if running_container "$PG_CONTAINER"; then "$CE" stop "$PG_CONTAINER" >/dev/null && ok "dev postgres stopped (volume kept; '$CE rm $PG_CONTAINER' to reset)"
  else ok "dev postgres not running"; fi
}

# ---- infra (minio + lakefs) ------------------------------------------------
up_infra()   { need_ce; say "minio + lakefs"; dc "$INFRA_COMPOSE" up -d && ok "minio :9000/:9001, lakefs :8000"; }
down_infra() { need_ce; dc "$INFRA_COMPOSE" down >/dev/null 2>&1 && ok "minio/lakefs down"; }

# ---- observability ---------------------------------------------------------
up_obs() {
  need_ce; ensure_podman_socket; say "observability stack"
  COMPOSE_PROFILES="$OBS_PROFILES" dc "$OBS_COMPOSE" up -d "${OBS_SERVICES[@]}" \
    && ok "logs :9428  metrics :8428  traces :16686  profiles :7070  otlp :4317"
}
down_obs() {
  need_ce; ensure_podman_socket
  COMPOSE_PROFILES="$OBS_PROFILES" dc "$OBS_COMPOSE" stop "${OBS_SERVICES[@]}" >/dev/null 2>&1 && ok "observability stopped"
}

# ---- app (sbt services + frontend in tmux, on JDK 17) ----------------------
ensure_session() { tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" -n _ "while :; do sleep 3600; done"; }
win() { echo "${1//[^A-Za-z0-9_-]/_}"; }
win_exists() { tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "$(win "$1")"; }
# A window is "alive" only if it exists AND its health port is listening. The dist
# launchers are bash wrappers, so the pane command is always `bash`; the bound
# port is the only reliable liveness signal (a crashed service releases it).
win_alive() {  # name  [healthport]
  local name="$1" port="${2:-}"
  win_exists "$name" || return 1
  [[ -n "$port" ]] || return 0           # no port to probe — assume the window means alive
  port_open "$port"
}
launch() {  # name  cwd  command  [ports...]   (first port is the health port)
  local name="$1" cwd="$2" cmd="$3"; shift 3
  local ports=("$@") w; w="$(win "$name")"
  ensure_session
  win_alive "$name" "${ports[0]:-}" && { ok "$name already running"; return; }
  win_exists "$name" && tmux kill-window -t "$SESSION:$w" 2>/dev/null   # clear a dead/crashed window
  local p; for p in "${ports[@]}"; do port_open "$p" && free_port "$p"; done  # clear orphans on all its ports
  tmux new-window -t "$SESSION" -n "$w" \
    "cd '$cwd' && $cmd; ec=\$?; echo; echo '[$name exited ('\$ec') — Ctrl-b & to close]'; read"
  ok "started $name"
}
up_app() {
  local with_frontend="${1:-yes}"   # pass 'no' to launch backend services only
  need tmux; require_jdk17 || true
  ensure_built
  ensure_rust_worker || true   # native worker for rust:<op> operators (non-fatal if absent)
  local java_env=""; [[ -n "$JDK17" ]] && java_env="JAVA_HOME='$JDK17'"
  local pyenv=""
  if [[ -n "${TEXERA_DEV_CONTAINER:-}" ]]; then
    ensure_py_venv || true   # in-box: build/point at the box's own UDF venv
    [[ -x "$TEXERA_VENV/bin/python" ]] && pyenv="UDF_PYTHON_PATH='$TEXERA_VENV/bin/python'"
  else
    [[ -x "$ROOT/../venv312/bin/python" ]] && pyenv="UDF_PYTHON_PATH='$ROOT/../venv312/bin/python'"
  fi
  # Services resolve their yaml under $TEXERA_HOME; pin it to the repo root or an
  # unset value doubles the path and they die "config not found".
  local home_env="TEXERA_HOME='$ROOT'"
  # Backend log level (default TRACE); export TEXERA_SERVICE_LOG_LEVEL to override.
  # Forwarded via env since tmux windows don't inherit the caller's shell env.
  local log_env="TEXERA_SERVICE_LOG_LEVEL='${TEXERA_SERVICE_LOG_LEVEL:-TRACE}'"
  # Point the engine at the native Rust worker (absolute path, so it resolves
  # regardless of each service's cwd). Empty if the build was skipped.
  local rust_env=""; [[ -x "$RUST_WORKER_BIN" ]] && rust_env="AMBER_RUST_WORKER_BIN='$RUST_WORKER_BIN'"
  # Wait for lakeFS if it's up so file-service doesn't crash racing it; no-op
  # otherwise (e.g. app-be without infra).
  running_container texera-lakefs-lakefs && wait_for_lakefs || true
  local n path
  for n in "${DEV_BACKENDS[@]}"; do
    path="$(launcher "$n")"
    [[ -n "$path" ]] || { warn "no launcher for $n — skipping"; continue; }
    launch "$n" "${path%/target/*}" "env $home_env $java_env $pyenv $log_env $rust_env '$path'" ${SVC_PORTS[$n]:-}
    sleep 1; [[ "$n" == config-service ]] && sleep 2
  done
  if [[ "$with_frontend" == yes && -f "$ROOT/frontend/package.json" ]]; then
    need yarn; require_node24 || true
    # Prepend Node 24 to the frontend window's PATH; $PATH stays literal so it
    # expands in that shell.
    local node_env=""; [[ -n "$NODE24_BIN" ]] && node_env="PATH=$NODE24_BIN:\$PATH "
    # ng serve otherwise runs with Node's default ~2GB old-space heap and OOMs
    # (exit 134, "Ineffective mark-compacts near heap limit") mid-compile on
    # Angular 21. The repo's own `build`/`build:ci` scripts bump the heap to 8G;
    # its `start` (which we replicate below) does not, so bump it here too.
    node_env="${node_env}NODE_OPTIONS=--max-old-space-size=8192 "
    # The UI is reached from the Traefik proxy (a separate container), whether it
    # runs in a box (proxy reaches it by name) or on the host (proxy reaches it via
    # the docker host-gateway). Either way ng serve must bind 0.0.0.0 and accept the
    # <folder>.localhost Host header. The repo's `start` wraps `ng serve` in
    # `concurrently`, so flags appended to `yarn start` never reach ng; replicate
    # it here with the flags on ng serve itself (keeping the y-websocket sidecar).
    local fe_pre=""
    local fe_cmd="npx concurrently --kill-others \"npx y-websocket\" \"ng serve --host 0.0.0.0 --disable-host-check\""
    # The box mounts an empty node_modules volume, so install deps first (a near
    # no-op once populated). Host runs already have node_modules.
    [[ -x "$ROOT/frontend/node_modules/.bin/ng" ]] || fe_pre="yarn install && "
    launch frontend "$ROOT/frontend" "${node_env}${fe_pre}${fe_cmd}" ${SVC_PORTS[frontend]}
    register_ui_route   # http://<folder>.localhost -> this UI (host or box); no-op if no proxy
    local proj; proj="$(multi_project)"
    if [[ -n "${TEXERA_DEV_CONTAINER:-}" ]]; then
      echo; ok "app launched: frontend via proxy at http://$proj.localhost , web API :8080 (in-box)"
    else
      echo; ok "app launched: frontend http://$proj.localhost (and http://localhost:4200)  web API http://localhost:8080"
    fi
  else
    echo; ok "backend launched — web API http://localhost:8080 (frontend not started)"
  fi
  echo "  logs: texera attach   stop: texera stop app"
}
down_app() {
  # Drop the host-app proxy route so http://<folder>.localhost stops 502'ing once
  # ng is gone. Guarded to host-app routes (host.docker.internal) so it never
  # clobbers a box route for the same folder.
  if [[ -z "${TEXERA_DEV_CONTAINER:-}" ]]; then
    local proj; proj="$(multi_project)"
    [[ -n "$proj" ]] && grep -q "host.docker.internal" "$PROXY_DYNAMIC/$proj.yml" 2>/dev/null && remove_proxy_route "$proj"
  fi
  tmux kill-session -t "$SESSION" 2>/dev/null && ok "app services stopped" || ok "app not running"
}
attach()   { tmux has-session -t "$SESSION" 2>/dev/null || die "no app session running"; tmux attach -t "$SESSION"; }

# ---- docker single-node ----------------------------------------------------
# bin/single-node/up.sh execs `docker compose` directly; under podman it needs the
# API socket up + DOCKER_HOST exported. No-op under docker.
ensure_compose_engine() { need_ce; ensure_podman_socket; }
run_docker() {
  ensure_compose_engine; say "single-node (all containers) via $CE"
  [[ -x "$SINGLE_NODE/up.sh" ]] || die "bin/single-node/up.sh not found"
  ( cd "$SINGLE_NODE" && ./up.sh -d ) || die "compose up failed"
  ok "UI http://localhost:8080 (texera/texera). logs: cd bin/single-node && $CE compose logs -f"
}
down_docker() { ensure_compose_engine; ( cd "$SINGLE_NODE" && "$CE" compose down ) && ok "single-node down"; }

# ---- multi (many checkouts at once, behind one reverse proxy) ---------------
# Run THIS checkout's full single-node stack as an isolated, proxied instance so
# several checkouts (texera / texera2 / texera3 / ...) run simultaneously with
# NO port juggling and NO code/port edits. Each instance is its own compose
# project named after the folder; a shared Traefik proxy on :80 routes
# http://<folder>.localhost to that instance's UI. See bin/texera-multi/.
#
# Fresh-like behaviour: the base compose bind-mounts THIS checkout's sql/ into
# postgres, so wiping the instance's volumes ('multi fresh') re-inits the DB
# from this branch's schema (the DB half of `texera fresh`). The services
# themselves run from prebuilt ghcr images by default (fast); to run your local
# Scala/frontend code instead, build local images and set IMAGE_REGISTRY/
# IMAGE_TAG (see the note printed by 'multi').
MULTI_PROXY="$MULTI_DIR/proxy.yml"
MULTI_OVERLAY="$MULTI_DIR/instance.override.yml"
PROXY_DYNAMIC="$MULTI_DIR/dynamic"   # Traefik file-provider routes (one .yml per instance)
# folder name -> a safe compose project + hostname label (lowercase, [a-z0-9-])
multi_project() { basename "$ROOT" | tr '[:upper:]_' '[:lower:]-' | tr -cd 'a-z0-9-'; }

mc() {  # compose for this instance: project-scoped, base + overlay
  local proj="$1"; shift
  TX_PROJECT="$proj" TX_HOST="$proj.localhost" \
    dc "$SINGLE_NODE/docker-compose.yml" -p "$proj" -f "$MULTI_OVERLAY" "$@"
}
ensure_proxy() {
  need_ce; ensure_podman_socket
  mkdir -p "$PROXY_DYNAMIC"   # bind-mounted into Traefik; must exist before 'up'
  if running_container texera-proxy; then ok "reverse proxy already up (:80)"; return; fi
  say "starting shared reverse proxy (Traefik on :80)"
  "$CE" compose -f "$MULTI_PROXY" up -d && ok "proxy up (dashboard: http://localhost:8090)" \
    || die "could not start the reverse proxy"
}
# Register/unregister a file-provider route: http://<proj>.localhost -> backend
# container (resolved by name over the shared texera-proxy network).
write_proxy_route() {  # proj  backend_host  backend_port
  local proj="$1" host="$2" port="$3"
  mkdir -p "$PROXY_DYNAMIC"
  cat > "$PROXY_DYNAMIC/$proj.yml" <<EOF
# Auto-generated by 'texera'. Routes http://$proj.localhost to $host:$port.
http:
  routers:
    $proj:
      rule: "Host(\`$proj.localhost\`)"
      entryPoints: [web]
      service: $proj
  services:
    $proj:
      loadBalancer:
        servers:
          - url: "http://$host:$port"
EOF
  ok "route http://$proj.localhost -> $host:$port"
}
remove_proxy_route() { rm -f "$PROXY_DYNAMIC/$1.yml" 2>/dev/null && ok "route http://$1.localhost removed" || true; }
# Point http://<folder>.localhost at THIS checkout's host `app` UI (ng serve on
# the host :4200), reached from the proxy via the docker host-gateway. Best-effort:
# needs a container engine + the shared proxy; skips quietly (UI still on :4200)
# otherwise. No-op inside a box: box_up already wrote that route on the OUTER host.
register_ui_route() {
  [[ -z "${TEXERA_DEV_CONTAINER:-}" ]] || return 0
  local proj; proj="$(multi_project)"; [[ -n "$proj" ]] || return 0
  detect_ce >/dev/null 2>&1 || { warn "no container engine; UI at http://localhost:4200 (proxy route skipped)"; return 0; }
  if ! running_container texera-proxy; then
    say "starting shared reverse proxy (Traefik on :80)"
    "$CE" compose -f "$MULTI_PROXY" up -d >/dev/null 2>&1 \
      || { warn "could not start reverse proxy; UI at http://localhost:4200"; return 0; }
  fi
  ensure_host_resolves "$proj.localhost"
  write_proxy_route "$proj" "host.docker.internal" 4200
}
# *.localhost must resolve to loopback for the browser/curl. Warn + offer an
# /etc/hosts line if it doesn't (systemd-resolved usually handles it, but NSS
# here does not, so curl/some browsers would fail without the hosts entry).
ensure_host_resolves() {
  local host="$1"
  getent hosts "$host" >/dev/null 2>&1 && return 0
  warn "$host does not resolve on this machine (NSS has no *.localhost rule)"
  if grep -q "[[:space:]]$host\b" /etc/hosts 2>/dev/null; then return 0; fi
  printf "  add '127.0.0.1 %s' to /etc/hosts now? [y/N] " "$host"
  local ans; read -r ans
  if [[ "$ans" =~ ^[Yy] ]]; then
    echo "127.0.0.1 $host" | sudo tee -a /etc/hosts >/dev/null \
      && ok "added $host to /etc/hosts" \
      || warn "could not edit /etc/hosts; add '127.0.0.1 $host' by hand"
  else
    warn "skipped; the browser may still resolve $host via systemd-resolved. If not, add '127.0.0.1 $host' to /etc/hosts"
  fi
}
run_multi() {
  local mode="${1:-up}"
  local proj; proj="$(multi_project)"
  [[ -n "$proj" ]] || die "could not derive a project name from $ROOT"
  [[ -f "$SINGLE_NODE/docker-compose.yml" ]] || die "no bin/single-node/docker-compose.yml in this checkout"
  need_ce
  case "$mode" in
    down)
      say "stopping instance '$proj'"
      mc "$proj" down && ok "instance '$proj' stopped (data volumes kept)"
      return ;;
    fresh)
      say "instance '$proj': wiping volumes (DB re-inits from this branch's sql/)"
      mc "$proj" down --volumes >/dev/null 2>&1 && ok "volumes wiped" || ok "nothing to wipe" ;;
    up) : ;;
    *) die "unknown multi mode: $mode (up|fresh|down)" ;;
  esac
  ensure_proxy
  ensure_host_resolves "$proj.localhost"
  say "starting instance '$proj' (project=$proj, host=$proj.localhost)"
  mc "$proj" up -d || die "compose up failed for '$proj'"
  echo
  ok "instance '$proj' up  ->  http://$proj.localhost   (login texera/texera)"
  echo "  first boot pulls images (~5 min). logs: TX_PROJECT=$proj $CE compose -p $proj -f $SINGLE_NODE/docker-compose.yml -f $MULTI_OVERLAY logs -f"
  echo "  stop: texera multi down    routes: http://localhost:8090"
  echo "  local code (not ghcr): build local images tagged e.g. texera-local, then IMAGE_REGISTRY=texera-local IMAGE_TAG=dev texera multi"
}
down_multi() { run_multi down; }

# ---- box (docker-in-docker dev container per checkout) ---------------------
# The primary multi-checkout model: each checkout gets ONE long-lived,
# privileged container ('<folder>-dev') built from bin/texera-multi/dev.Dockerfile
# (full toolchain + its own inner dockerd). The checkout's source is bind-mounted
# at the SAME path, so `texera <target>` execs into the box and runs the
# EXISTING logic against your REAL code: fresh/refresh build your local code,
# db/infra/obs/docker spin up in the box's own dockerd, fully isolated.
#
# Because each box has its own localhost + port space, nothing collides and no
# ports change in code. A shared Traefik proxy routes http://<folder>.localhost
# to that box's ng-serve (:4200). Once a box is running, plain `texera
# <target>` auto-dispatches into it (escape with TEXERA_NO_BOX=1).
DEV_DOCKERFILE="$MULTI_DIR/dev.Dockerfile"
DEV_IMAGE="${TEXERA_DEV_IMAGE:-texera-dev:latest}"
# Per-box memory ceiling. Without it every box shares the host RAM unbounded, so
# when several full stacks (each an ng serve ~3G + a handful of JVMs + inner
# postgres/minio/lakefs) overcommit, the HOST OOM-killer kills whichever process
# it likes, taking down random *neighbour* boxes: "the rest keep breaking". A
# --memory cap makes each box its OWN cgroup OOM domain, so an overcommitting box
# pages to swap (up to --memory-swap) and, past that, OOMs only its own inner
# processes, leaving other boxes alone. TEXERA_BOX_MEM='' disables the cap.
#   RAM ceiling   : TEXERA_BOX_MEM      (default 8g)
#   RAM+swap total: TEXERA_BOX_MEMSWAP  (default 16g -> up to 8g of swap headroom
#                   per box so idle stacks page out instead of getting killed;
#                   needs enough host swap, see 'texera box' notes)
BOX_MEM="${TEXERA_BOX_MEM-8g}"
BOX_MEMSWAP="${TEXERA_BOX_MEMSWAP-16g}"
box_name() { local p; p="$(multi_project)"; [[ -n "$p" ]] && echo "$p-dev"; }

box_build() {
  need_ce
  if [[ "${1:-}" != force ]] && "$CE" image inspect "$DEV_IMAGE" >/dev/null 2>&1; then
    ok "dev image $DEV_IMAGE present ('box build force' to rebuild)"; return 0
  fi
  say "building dev image $DEV_IMAGE (toolchain + dind; slow the first time)"
  "$CE" build -t "$DEV_IMAGE" -f "$DEV_DOCKERFILE" "$MULTI_DIR" \
    && ok "built $DEV_IMAGE" || die "dev image build failed"
}
box_up() {
  need_ce
  local box proj; box="$(box_name)"; proj="$(multi_project)"
  [[ -n "$proj" ]] || die "could not derive a box name from $ROOT"
  ensure_proxy
  ensure_host_resolves "$proj.localhost"
  box_build
  if running_container "$box"; then ok "box '$box' already running"
  elif have_container "$box"; then say "starting existing box '$box'"; "$CE" start "$box" >/dev/null
  else
    say "creating box '$box' (privileged dind; real code bind-mounted at $ROOT)"
    # Memory cap so one overcommitting box can't OOM-kill its neighbours (see
    # BOX_MEM). Empty TEXERA_BOX_MEM -> no cap (old unbounded behaviour).
    local mem_args=()
    if [[ -n "$BOX_MEM" ]]; then
      mem_args=(--memory "$BOX_MEM"); [[ -n "$BOX_MEMSWAP" ]] && mem_args+=(--memory-swap "$BOX_MEMSWAP")
      ok "memory cap: $BOX_MEM RAM${BOX_MEMSWAP:+ / $BOX_MEMSWAP incl. swap} (TEXERA_BOX_MEM to change)"
    fi
    # --init: run tini as PID 1 so orphaned children (a stack's tmux/java/ng after
    # it is killed or crashes) get reaped instead of piling up as zombies under
    # the entrypoint's `sleep infinity`, which is not a reaping init.
    "$CE" run -d --name "$box" --privileged --init --restart unless-stopped \
      "${mem_args[@]}" \
      --network texera-proxy \
      -v "$ROOT:$ROOT" \
      -v "$HOME/dotfiles/bin:/opt/dotbin:ro" \
      -v "${box}-docker:/var/lib/docker" \
      -v "${box}-ivy:/root/.ivy2" \
      -v "${box}-sbt:/root/.sbt" \
      -v "${box}-coursier:/root/.cache/coursier" \
      -v "${box}-cargo:/usr/local/cargo" \
      -v "${box}-nodemods:$ROOT/frontend/node_modules" \
      -v "${box}-venv:$TEXERA_VENV" \
      -e UDF_PYTHON_PATH="$TEXERA_VENV/bin/python" \
      -w "$ROOT" -e TEXERA_HOME="$ROOT" \
      "$DEV_IMAGE" >/dev/null || die "could not create box '$box'"
  fi
  # Register the proxy route (Traefik reaches the box by name over texera-proxy).
  write_proxy_route "$proj" "$box" 4200
  printf "  waiting for inner docker in '%s'" "$box"; local i
  for i in $(seq 1 60); do "$CE" exec "$box" docker info >/dev/null 2>&1 && break; printf '.'; sleep 1; done; echo
  "$CE" exec "$box" docker info >/dev/null 2>&1 \
    && ok "box '$box' ready" \
    || warn "inner docker not ready; check: $CE exec $box tail /var/log/dockerd.log"
  echo
  ok "box '$box' up. Run targets in it, e.g.:  texera fresh   (UI: http://$proj.localhost)"
  echo "  shell: texera box shell    stop: texera box down    run on host instead: TEXERA_NO_BOX=1 texera <cmd>"
}
box_down() {
  need_ce; local box proj; box="$(box_name)"; proj="$(multi_project)"
  remove_proxy_route "$proj"   # drop the route so it doesn't 502 while the box is down
  running_container "$box" && { "$CE" stop "$box" >/dev/null && ok "box '$box' stopped (volumes kept)"; } || ok "box '$box' not running"
}
box_rm() {
  need_ce; local box proj; box="$(box_name)"; proj="$(multi_project)"
  remove_proxy_route "$proj"
  "$CE" rm -f "$box" >/dev/null 2>&1 && ok "removed box container '$box' (named volumes kept)" || ok "no box container '$box'"
}
box_shell() { need_ce; local box; box="$(box_name)"; running_container "$box" || die "box '$box' not running ('texera box up')"; "$CE" exec -it "$box" bash; }
box_status() {
  need_ce; local box; box="$(box_name)"
  if running_container "$box"; then
    ok "box '$box' running"
    "$CE" exec "$box" docker ps --format '  inner: {{.Names}} ({{.Status}})' 2>/dev/null || true
  else ok "box '$box' not running"; fi
}
# Build artifacts the root box writes into the bind-mounted source end up
# root-owned on the host. Hand ownership back to the invoking user.
box_chown() {
  need_ce; local box; box="$(box_name)"; running_container "$box" || die "box '$box' not running"
  say "restoring ownership of $ROOT to $(id -u):$(id -g)"
  "$CE" exec "$box" chown -R "$(id -u):$(id -g)" "$ROOT" && ok "ownership restored"
}
run_box() {
  case "${1:-up}" in
    up|"")     box_up ;;
    down|stop) box_down ;;
    rm|remove) box_down; box_rm ;;
    build)     shift; box_build "${1:-force}" ;;
    shell|sh)  box_shell ;;
    status)    box_status ;;
    chown)     box_chown ;;
    *) die "unknown box subcommand: ${1} (up|down|rm|build|shell|status|chown)" ;;
  esac
}

# ---- kubernetes (helm, prod values) ----------------------------------------
run_k8s() {
  need helm; need kubectl; local chart="$ROOT/bin/k8s"
  say "helm install (context: $(kubectl config current-context 2>/dev/null || echo '?'))"
  helm dependency build "$chart" || die "helm dependency build failed"
  helm upgrade --install texera "$chart" -f "$chart/values.yaml" || die "helm install failed"
  ok "release 'texera' applied. watch: kubectl get pods -w"
}
down_k8s() { need helm; helm uninstall texera && ok "helm release 'texera' removed"; }

# ---- status ----------------------------------------------------------------
status() {
  find_jdk17
  say "Texera status"
  echo "  JDK 17:     ${JDK17:-${c_red}none, getSubject will fail on 24+${c_off}}"
  printf "  rust wkr:   "; [[ -x "$RUST_WORKER_BIN" ]] && echo "${c_grn}built${c_off} ($RUST_WORKER_BIN)" || echo "${c_yel}not built${c_off} (texera rust)"
  detect_ce >/dev/null 2>&1
  printf "  engine:     "; [[ -n "$CE" ]] && echo "${c_grn}$CE${c_off}" || echo "${c_red}none (no docker daemon / podman)${c_off}"
  local c
  printf "  db:         "; port_open 5432 && echo "${c_grn}:5432 reachable${c_off}" || echo "${c_dim}down${c_off}"
  printf "  infra:      "; running_container texera-lakefs-minio && echo "${c_grn}up${c_off}" || echo "${c_dim}down${c_off}"
  printf "  observ.:    "; running_container texera-victorialogs && echo "${c_grn}up${c_off}" || echo "${c_dim}down${c_off}"
  printf "  app (tmux): "; tmux has-session -t "$SESSION" 2>/dev/null && tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -v '^_$' | paste -sd' ' - || echo "${c_dim}down${c_off}"
  local p busy=()
  for p in "${APP_PORTS[@]}"; do port_open "$p" && busy+=("$p"); done
  printf "  app ports:  "; [[ ${#busy[@]} -eq 0 ]] && echo "${c_dim}all free${c_off}" || echo "${c_yel}in use: ${busy[*]}${c_off} (texera free-ports)"
}

# ---- prune (reclaim docker disk) -------------------------------------------
# Reclaim disk: dangling images, build cache, and stopped containers. NEVER
# volumes, so the DB / MinIO / lakeFS data survives. Sweeps the HOST daemon AND
# every running box's inner dockerd, because docker-in-docker keeps its own
# images/cache inside each box's docker volume (a host prune can't see those).
# 'prune all' additionally drops unused *tagged* images (forces a re-pull or
# rebuild on the next start). Deliberately a separate verb, NOT wired into
# 'stop' by default: a stopped stack's images look "unused", so an implicit
# prune would delete exactly the images the next start needs. Opt in per stop
# with 'texera stop --prune' / '--prune-all'.
_prune_one() {  # label  engine-cmd...   (engine-cmd = e.g. "$CE"  or  "$CE exec <box> docker")
  local label="$1"; shift
  local out
  out="$("$@" container prune -f 2>/dev/null | grep -iE 'reclaimed|^total:')"; [[ -n "$out" ]] && echo "  [$label] containers:  $out"
  out="$("$@" image prune -f     2>/dev/null | grep -iE 'reclaimed|^total:')"; [[ -n "$out" ]] && echo "  [$label] images(dang): $out"
  if [[ -n "${_prune_all:-}" ]]; then
    out="$("$@" image prune -a -f 2>/dev/null | grep -iE 'reclaimed|^total:')"; [[ -n "$out" ]] && echo "  [$label] images(all):  $out"
  fi
  out="$("$@" builder prune -f   2>/dev/null | grep -iE 'reclaimed|^total:')"; [[ -n "$out" ]] && echo "  [$label] build-cache: $out"
}
run_prune() {
  need_ce
  _prune_all=""; case "${1:-}" in all|-a|aggressive) _prune_all=1 ;; esac
  say "reclaiming docker disk${_prune_all:+ (aggressive: also unused tagged images)}; volumes are left untouched"
  _prune_one host "$CE"
  local b
  for b in $("$CE" ps --format '{{.Names}}' 2>/dev/null | grep -- '-dev$'); do
    if "$CE" exec "$b" docker info >/dev/null 2>&1; then
      _prune_one "$b" "$CE" exec "$b" docker
    else
      warn "box '$b' inner docker unreachable, skipping its prune"
    fi
  done
  ok "prune complete (DB / MinIO / lakeFS volumes were NOT touched)"
}

# ---- debug pipeline --------------------------------------------------------
# db + infra + backends, then relaunch the Amber engine under JDWP on :5005 to
# attach (:TexeraDebug in nvim, or IntelliJ remote).
run_debug() {
  local port="${TEXERA_DEBUG_PORT:-5005}"
  if [[ "${1:-}" == stop ]]; then
    tmux kill-window -t "$SESSION:cum-debug" 2>/dev/null; down_app; return
  fi
  require_jdk17 || true
  up_db; up_infra
  # wait for lakeFS health BEFORE backends so file-service doesn't race it and crash
  say "waiting for lakeFS health (:8000) before backends..."
  local i
  for i in $(seq 1 60); do
    [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:8000/_health 2>/dev/null)" == 200 ]] && break
    sleep 1
  done
  up_app no          # backend services, no frontend
  say "waiting for backends to be healthy..."
  for i in $(seq 1 90); do
    local up=1 p
    for p in 9094 9096 9092 9090 8888 8080; do port_open "$p" || { up=0; break; }; done
    [[ "$up" == 1 ]] && break; sleep 2
  done
  local L; L="$(launcher computing-unit-master)"
  [[ -n "$L" ]] || die "no computing-unit-master launcher (run: texera rebuild)"
  # The engine (this process) spawns the native Rust worker for rust:<op> ops.
  local rust_env=""; [[ -x "$RUST_WORKER_BIN" ]] && rust_env="AMBER_RUST_WORKER_BIN='$RUST_WORKER_BIN'"
  say "relaunching the engine under the debugger (JDWP :$port)..."
  local p
  for p in 8085 2552 "$port"; do port_open "$p" && free_port "$p"; done
  sleep 2
  ensure_session
  tmux new-window -t "$SESSION" -n cum-debug -c "$ROOT/amber" \
    "env TEXERA_HOME='$ROOT' JAVA_HOME='$JDK17' $rust_env '$L' -jvm-debug $port"
  for i in $(seq 1 60); do port_open "$port" && break; sleep 1; done
  echo
  if port_open "$port"; then ok "engine running under the debugger - JDWP on localhost:$port"
  else warn "engine not on :$port yet - watch it: texera attach (window cum-debug)"; fi
  cat <<EOF

Attach from nvim (current editor):
  :luafile $ROOT/profiling/nvim_tuple_debug.lua   (sets breakpoints + dap configs)
  :TexeraDebug                                      (attach + set breakpoints)
Then set breakpoints (<leader>b) and Run a workflow (web UI, or profiling/tx_client.py).
Stop the debug engine:  texera debug stop
EOF
}

# ---- target dispatch -------------------------------------------------------
start_target() {
  case "$1" in
    db)    up_db ;;
    infra) up_infra ;;
    obs|observability) up_obs ;;
    app)   up_app yes ;;
    app-be|backend) up_app no ;;
    rust)  ensure_rust_worker force ;;
    docker|single) run_docker ;;
    k8s|kubernetes)  run_k8s ;;
    *) die "unknown target: $1 (db|infra|obs|app|app-be|rust|dev|debug|docker|k8s)" ;;
  esac
}
stop_target() {
  case "$1" in
    db)    down_db ;;
    infra) down_infra ;;
    obs|observability) down_obs ;;
    app|app-be|backend)   down_app ;;
    docker|single) down_docker ;;
    k8s|kubernetes)  down_k8s ;;
    *) die "unknown target: $1" ;;
  esac
}
# expand 'dev' and normalize order so dependencies come up first
expand_targets() {
  local t out=()
  for t in "$@"; do
    case "$t" in
      dev)           out+=(db infra app) ;;   # obs is its own target now
      backend)       out+=(app-be) ;;
      observability) out+=(obs) ;;
      single)        out+=(docker) ;;
      kubernetes)    out+=(k8s) ;;
      *)             out+=("$t") ;;
    esac
  done
  # unique, in canonical order (app-be before app so backend-only wins if both given)
  local order=(db infra obs rust app-be app docker k8s) o
  for o in "${order[@]}"; do printf '%s\n' "${out[@]}" | grep -qx "$o" && echo "$o"; done
}

# ---- entrypoint ------------------------------------------------------------
# ---- dev-box dispatch ------------------------------------------------------
# If this checkout's dev box is running and we're on the host (not already
# inside it), run the SAME command inside the box against the mounted real code.
# 'box' management and help always stay on the host; TEXERA_NO_BOX=1 forces host.
if [[ -z "${TEXERA_DEV_CONTAINER:-}" && -z "${TEXERA_NO_BOX:-}" ]]; then
  _box="$(box_name 2>/dev/null)"
  case "${1:-}" in
    box|multi|prune|-h|--help|help) _box="" ;;   # host-level commands: never use the box (prune sweeps boxes itself)
  esac
  if [[ -n "$_box" ]]; then
    # For app-run targets, create the box on demand so `texera fresh` just
    # works with no separate `box up`. Read-only/host commands (status, stop,
    # free-ports, ...) only redirect into a box that's ALREADY running.
    if ! running_container "$_box"; then
      case "${1:-}" in
        fresh|refresh|dev|app|app-be|backend|obs|observability|debug|docker|single|rust|k8s|kubernetes)
          say "no dev box for this checkout yet; creating '$_box' first"; box_up ;;
      esac
    fi
    if running_container "$_box"; then
      # Re-assert the proxy route for app-run targets: a host `app` run rewrites
      # it to host.docker.internal, and the box can't fix it (/opt/dotbin is ro).
      case "${1:-}" in
        fresh|refresh|dev|app|app-be|backend) write_proxy_route "$(multi_project)" "$_box" 4200 ;;
      esac
      say "running in dev box '$_box' (real code at $ROOT)"
      _tty=(-i); [[ -t 0 ]] && _tty=(-it)
      exec "$CE" exec "${_tty[@]}" -w "$ROOT" "$_box" texera "$@"
    fi
  fi
fi

cmd="${1:-}"
case "$cmd" in
  ""|menu)
    echo "${c_cyn}Texera launcher${c_off} — targets (space-separated, e.g. 'obs' or 'db infra app' or 'dev'):"
    echo "  ${c_grn}db${c_off} postgres   ${c_grn}infra${c_off} minio+lakefs   ${c_grn}obs${c_off} observability   ${c_grn}app${c_off} services+frontend"
    echo "  ${c_grn}app-be${c_off} backend only (no frontend)   ${c_grn}rust${c_off} (re)build native Rust worker   ${c_grn}dev${c_off} = db+infra+app"
    echo "  ${c_grn}debug${c_off} = full pipeline, engine under JDWP on :5005 (then :TexeraDebug in nvim)"
    echo "  ${c_grn}docker${c_off} single-node    ${c_grn}k8s${c_off} helm"
    echo "  ${c_grn}multi${c_off} = this checkout as an isolated instance behind a shared proxy (http://<folder>.localhost); 'multi fresh' wipes its DB, 'multi down' stops it"
    echo "  ${c_grn}box${c_off} up = DinD dev container for this checkout; after that every 'texera <target>' runs IN it against your real code (box down|shell|status|chown)"
    echo "  ${c_grn}fresh${c_off} = wipe DB + clean rebuild + start dev (from-scratch install test)"
    echo "  ${c_grn}refresh${c_off} = rebuild + restart app, no data wipe (after code changes)"
    echo "  ${c_grn}prune${c_off} = reclaim docker disk (host + boxes: dangling images, build cache, stopped containers; 'prune all' also unused images; volumes never touched)"
    read -rp "start> " line
    [[ -n "${line:-}" ]] || die "nothing selected"
    read -ra TGTS <<< "$line"
    for t in $(expand_targets "${TGTS[@]}"); do start_target "$t"; done
    ;;
  stop|down)
    shift
    # optional trailing --prune / --prune-all: reclaim docker disk AFTER stopping
    STOP_PRUNE=""; STOP_ARGS=()
    for a in "$@"; do
      case "$a" in
        --prune)     STOP_PRUNE=safe ;;
        --prune-all) STOP_PRUNE=all ;;
        *)           STOP_ARGS+=("$a") ;;
      esac
    done
    set -- "${STOP_ARGS[@]}"
    if [[ $# -eq 0 ]]; then set -- dev; fi   # default: tear down the local dev stack
    # stop in reverse dependency order (app first, db last)
    mapfile -t T < <(expand_targets "$@" | tac)
    for t in "${T[@]}"; do stop_target "$t"; done
    [[ -n "$STOP_PRUNE" ]] && run_prune "$([[ "$STOP_PRUNE" == all ]] && echo all)"
    ;;
  prune)   shift; run_prune "${1:-}" ;;   # reclaim docker disk (host + boxes); 'prune all' also drops unused images; volumes never touched
  box)     shift; run_box "$@" ;;     # DinD dev box: run all targets in-container against real code
  multi)   shift; run_multi "${1:-up}" ;;   # this checkout as an isolated, proxied instance (many checkouts at once)
  debug)   shift; run_debug "$@" ;;   # full debug pipeline (engine under JDWP on :5005)
  fresh)   run_fresh ;;               # wipe DB + clean rebuild + start dev (from-scratch install test)
  refresh) shift; run_refresh "${1:-}" ;;   # non-destructive: rebuild + restart app, no data wipe
  rebuild) shift; down_app; rebuild "${1:-clean}" ;;   # stop app first; clean build by default
  attach)  attach ;;
  status)  status ;;
  free-ports|free|clear-ports|clear) free_ports ;;
  -h|--help|help) sed -n '2,30p' "$0" ;;
  *)
    # one or more start targets
    for t in $(expand_targets "$@"); do start_target "$t"; done
    ;;
esac
